---
import projects from '../data/projects.json';

const portview = projects.find((p) => p.id === 'portview') || projects[0];
---

<section id="portview" class="py-16 md:py-24 border-b border-[var(--color-border)] bg-[var(--bg-gradient-section)] transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded border border-[var(--color-badge-emerald-border)] bg-[var(--color-badge-emerald-bg)] text-[var(--color-badge-emerald-text)] text-xs font-mono mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>// FLAGSHIP C++ SYSTEM TOOL</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)] flex items-center gap-3">
          <span>{portview.name}</span>
          <span class="text-xs font-mono font-normal px-2.5 py-1 rounded-full bg-[var(--color-badge-emerald-bg)] border border-[var(--color-badge-emerald-border)] text-[var(--color-badge-emerald-text)]">
            C++ / Windows SDK
          </span>
        </h2>
      </div>
      <div class="mt-4 md:mt-0">
        <a
          href={portview.github_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-[var(--color-bg-surface)] hover:bg-[var(--color-bg-surface-hover)] border border-[var(--color-border)] text-emerald-600 dark:text-emerald-400 text-sm font-mono transition-all shadow-sm"
        >
          <span>View Source on GitHub</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Main Showcase Card -->
    <!-- Flagship Grid: Overview + Live CLI Interactive Terminal -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-8">
      
      <!-- Left Column: Problem, Value Proposition & Specs -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="p-6 sm:p-8 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] space-y-4 shadow-sm h-full flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-bold text-[var(--color-text-primary)] flex items-center space-x-2 font-mono">
                <span class="text-emerald-600 dark:text-emerald-400">01.</span>
                <span>System Overview & One-Liner</span>
              </h3>
              <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                Production Tool
              </span>
            </div>
            <p class="text-[var(--color-text-secondary)] text-base sm:text-lg leading-relaxed">
              {portview.one_liner}
            </p>
            <p class="text-[var(--color-text-tertiary)] text-sm leading-relaxed">
              Built to replace heavyweight GUI network monitors and cumbersome command chains. Queries the Windows kernel directly via Win32 IP Helper API, extracting real-time TCP/UDP endpoint mappings, process owners, and socket bandwidth with sub-millisecond execution times.
            </p>
          </div>

          <div class="pt-4 border-t border-[var(--color-border)] flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              {portview.tech_stack?.map((tech) => (
                <span class="px-2.5 py-1 rounded bg-[var(--color-bg-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-secondary)] text-xs font-mono font-medium">
                  {tech}
                </span>
              ))}
              <span class="px-2.5 py-1 rounded bg-[var(--color-badge-emerald-bg)] border border-[var(--color-badge-emerald-border)] text-[var(--color-badge-emerald-text)] text-xs font-mono">
                MIT License
              </span>
            </div>
            <span class="text-xs font-mono text-[var(--color-text-tertiary)]">
              MSVC x64 · Win32 Native
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Terminal Preview & CLI Inspector -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div class="rounded-2xl border border-zinc-800 bg-zinc-950 shadow-2xl overflow-hidden font-mono text-xs flex flex-col h-full justify-between glow-border hover:border-emerald-500/40 transition-all duration-300">
          <!-- Terminal Titlebar & Command Tabs -->
          <div class="bg-zinc-900 px-4 py-3 border-b border-zinc-800 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-red-500/90 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/90 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/90 inline-block"></span>
            </div>
            <div class="flex items-center space-x-1 bg-zinc-950 p-1 rounded-lg border border-zinc-800 text-[11px]">
              <button
                type="button"
                data-pv-tab="scan"
                class="pv-tab-btn px-2.5 py-0.5 rounded bg-zinc-800 text-emerald-400 font-bold transition-all cursor-pointer"
              >
                --stats
              </button>
              <button
                type="button"
                data-pv-tab="pid"
                class="pv-tab-btn px-2.5 py-0.5 rounded text-zinc-400 hover:text-zinc-200 transition-all cursor-pointer"
              >
                --pid
              </button>
              <button
                type="button"
                data-pv-tab="help"
                class="pv-tab-btn px-2.5 py-0.5 rounded text-zinc-400 hover:text-zinc-200 transition-all cursor-pointer"
              >
                --help
              </button>
            </div>
          </div>

          <!-- Terminal Screen Body -->
          <div class="p-5 font-mono text-zinc-300 min-h-[290px] flex flex-col justify-between space-y-4">
            <!-- Tab 1: --stats view -->
            <div id="pv-pane-scan" class="pv-tab-pane space-y-2.5">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-bold">portview.exe --stats</span>
              </div>
              <p class="text-zinc-500 text-[11px]">Enumerating active network endpoints via IPHLPAPI...</p>
              <div class="border-t border-zinc-800/80 pt-2 font-mono text-[11px] space-y-1">
                <div class="text-zinc-500 font-bold flex justify-between">
                  <span>PROTO / ENDPOINT</span>
                  <span>STATE</span>
                  <span>SPEED</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-cyan-400">TCP</strong> 0.0.0.0:8080</span>
                  <span class="text-emerald-400 font-semibold">LISTENING</span>
                  <span class="text-zinc-500">0 B/s</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-cyan-400">TCP</strong> 192.168.1.5:443</span>
                  <span class="text-emerald-400 font-semibold">ESTABLISHED</span>
                  <span class="text-emerald-300">1.4 MB/s</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-cyan-400">TCP</strong> 192.168.1.5:22</span>
                  <span class="text-emerald-400 font-semibold">ESTABLISHED</span>
                  <span class="text-emerald-300">42 KB/s</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-yellow-400">UDP</strong> 0.0.0.0:53</span>
                  <span class="text-zinc-400 font-semibold">STATELESS</span>
                  <span class="text-zinc-500">2.1 KB/s</span>
                </div>
              </div>
              <div class="pt-2 text-emerald-400 font-bold text-[11px] flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>[OK] Zero packet drop · Polling latency &lt;0.4ms</span>
              </div>
            </div>

            <!-- Tab 2: --pid view -->
            <div id="pv-pane-pid" class="pv-tab-pane hidden space-y-2.5">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-bold">portview.exe --pid --all</span>
              </div>
              <p class="text-zinc-500 text-[11px]">Resolving socket owners using QueryFullProcessImageNameW...</p>
              <div class="border-t border-zinc-800/80 pt-2 font-mono text-[11px] space-y-1">
                <div class="text-zinc-500 font-bold flex justify-between">
                  <span>PID / PROCESS</span>
                  <span>PORT</span>
                  <span>BOUND IP</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">4212 <span class="text-zinc-400">nginx.exe</span></span>
                  <span class="text-cyan-300 font-mono">:8080</span>
                  <span class="text-zinc-400">127.0.0.1</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">8190 <span class="text-zinc-400">chrome.exe</span></span>
                  <span class="text-cyan-300 font-mono">:443</span>
                  <span class="text-zinc-400">192.168.1.5</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">9012 <span class="text-zinc-400">sshd.exe</span></span>
                  <span class="text-cyan-300 font-mono">:22</span>
                  <span class="text-zinc-400">0.0.0.0</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">1044 <span class="text-zinc-400">svchost.exe</span></span>
                  <span class="text-cyan-300 font-mono">:53</span>
                  <span class="text-zinc-400">127.0.0.53</span>
                </div>
              </div>
              <div class="pt-2 text-cyan-400 font-semibold text-[11px]">
                ✔ 4 processes matched with elevated user privileges.
              </div>
            </div>

            <!-- Tab 3: --help view -->
            <div id="pv-pane-help" class="pv-tab-pane hidden space-y-2 text-[11px]">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-bold">portview.exe --help</span>
              </div>
              <p class="text-zinc-400">PORTVIEW v1.2 — High-Performance Windows Socket Inspector</p>
              <div class="border-t border-zinc-800/80 pt-2 space-y-1 text-zinc-300 font-mono">
                <p><span class="text-emerald-400 font-bold">-s, --stats</span>   Display live bandwidth &amp; transfer metrics</p>
                <p><span class="text-emerald-400 font-bold">-p, --pid</span>     Resolve PID to process name &amp; binary path</p>
                <p><span class="text-emerald-400 font-bold">-f, --filter</span>  Filter by protocol (tcp4, tcp6, udp4, udp6)</p>
                <p><span class="text-emerald-400 font-bold">-j, --json</span>    Output telemetry as NDJSON / structured data</p>
              </div>
              <p class="text-zinc-500 pt-2 text-[10px]">Zero external runtimes or DLL dependencies required.</p>
            </div>

            <!-- Bottom Prompt Line -->
            <div class="pt-3 border-t border-zinc-900 flex items-center justify-between text-[11px]">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-semibold animate-pulse">_</span>
              </div>
              <span class="text-zinc-500 font-mono text-[10px]">Win32 SDK · C++20</span>
            </div>
          </div>

          <!-- Bottom Status Bar -->
          <div class="p-3.5 bg-zinc-900/80 border-t border-zinc-800/80 text-zinc-400 text-xs flex justify-between items-center">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-mono text-zinc-300 text-[11px]">Target: Windows 10/11, Server</span>
            </div>
            <a
              href={portview.github_url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-400 hover:text-emerald-300 font-mono font-semibold flex items-center space-x-1 text-xs"
            >
              <span>Source Repo</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Full-Width Bottom Section: Architecture Pipeline & Engineering Capabilities -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Architecture Flow Diagram (Spans 6 cols on lg) -->
      <div class="lg:col-span-6 p-6 sm:p-8 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] space-y-4 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-[var(--color-text-primary)] flex items-center space-x-2 font-mono">
            <span class="text-emerald-600 dark:text-emerald-400">02.</span>
            <span>Low-Level Architecture Flow</span>
          </h3>
          <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            Zero Dependencies
          </span>
        </div>

        <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
          Internal pipeline execution: processes user flags, fetches socket tables directly from the Windows kernel memory space, maps socket ownership, and outputs streaming data.
        </p>

        <div class="p-3 rounded-xl bg-zinc-950/90 border border-zinc-800 text-zinc-300 font-mono text-xs overflow-x-auto">
          <svg class="w-full min-w-[480px] h-32" viewBox="0 0 600 130" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Node 1: CLI Args -->
            <rect x="10" y="35" width="105" height="60" rx="8" fill="#18181b" stroke="#3f3f46" stroke-width="1.5"/>
            <text x="62" y="60" text-anchor="middle" fill="#10b981" font-size="11" font-weight="bold" font-family="monospace">CLI Input</text>
            <text x="62" y="78" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="monospace">--stats --pid</text>

            <!-- Arrow 1 -->
            <path d="M115 65 L143 65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
            <polygon points="147,65 140,61 140,69" fill="#10b981"/>

            <!-- Node 2: Win32 API -->
            <rect x="150" y="35" width="130" height="60" rx="8" fill="#18181b" stroke="#059669" stroke-width="1.5"/>
            <text x="215" y="58" text-anchor="middle" fill="#34d399" font-size="11" font-weight="bold" font-family="monospace">IPHLPAPI</text>
            <text x="215" y="76" text-anchor="middle" fill="#a1a1aa" font-size="8.5" font-family="monospace">GetExtendedTcpTable</text>

            <!-- Arrow 2 -->
            <path d="M280 65 L308 65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
            <polygon points="312,65 305,61 305,69" fill="#10b981"/>

            <!-- Node 3: Socket Resolver -->
            <rect x="315" y="35" width="130" height="60" rx="8" fill="#18181b" stroke="#0891b2" stroke-width="1.5"/>
            <text x="380" y="58" text-anchor="middle" fill="#22d3ee" font-size="11" font-weight="bold" font-family="monospace">Process Mapping</text>
            <text x="380" y="76" text-anchor="middle" fill="#a1a1aa" font-size="8.5" font-family="monospace">PID → QueryName</text>

            <!-- Arrow 3 -->
            <path d="M445 65 L473 65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
            <polygon points="477,65 470,61 470,69" fill="#10b981"/>

            <!-- Node 4: Stream Output -->
            <rect x="480" y="35" width="110" height="60" rx="8" fill="#18181b" stroke="#3f3f46" stroke-width="1.5"/>
            <text x="535" y="58" text-anchor="middle" fill="#38bdf8" font-size="11" font-weight="bold" font-family="monospace">CLI Stream</text>
            <text x="535" y="76" text-anchor="middle" fill="#a1a1aa" font-size="8.5" font-family="monospace">Tabular Output</text>
          </svg>
        </div>

        <div class="flex items-center justify-between text-xs font-mono text-[var(--color-text-tertiary)] pt-1">
          <span>Kernel Table Traversal</span>
          <span class="text-emerald-500 font-semibold">O(N) Scantime</span>
        </div>
      </div>

      <!-- Key Capabilities & System Metric Cards (Spans 6 cols on lg) -->
      <div class="lg:col-span-6 p-6 sm:p-8 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] space-y-4 shadow-sm flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] flex items-center space-x-2 font-mono">
              <span class="text-emerald-600 dark:text-emerald-400">03.</span>
              <span>Key Engineering Capabilities</span>
            </h3>
            <span class="text-[10px] font-mono text-[var(--color-text-tertiary)]">Architecture Highlights</span>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
            <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)] border border-[var(--color-border)] space-y-1">
              <div class="flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <h4 class="text-xs font-mono font-bold text-[var(--color-text-primary)]">Kernel Memory Access</h4>
              </div>
              <p class="text-[11px] text-[var(--color-text-secondary)] leading-relaxed">
                Queries TCP/UDP connection tables directly via Win32 IP Helper API (<code class="text-emerald-600 dark:text-emerald-300 font-mono text-[10px]">IPHLPAPI</code>).
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)] border border-[var(--color-border)] space-y-1">
              <div class="flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
                <h4 class="text-xs font-mono font-bold text-[var(--color-text-primary)]">Real-time PID Resolution</h4>
              </div>
              <p class="text-[11px] text-[var(--color-text-secondary)] leading-relaxed">
                Resolves owner Process IDs to active process executable paths dynamically with zero external queries.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)] border border-[var(--color-border)] space-y-1">
              <div class="flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                <h4 class="text-xs font-mono font-bold text-[var(--color-text-primary)]">Traffic &amp; Connection Stats</h4>
              </div>
              <p class="text-[11px] text-[var(--color-text-secondary)] leading-relaxed">
                Tracks socket connection states, bandwidth transfer metrics, and local/remote endpoint bindings.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)] border border-[var(--color-border)] space-y-1">
              <div class="flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                <h4 class="text-xs font-mono font-bold text-[var(--color-text-primary)]">Zero Dependency Binary</h4>
              </div>
              <p class="text-[11px] text-[var(--color-text-secondary)] leading-relaxed">
                Native C++ binary compiled against Windows SDK. Single portable executable with zero VC++ runtime dependency.
              </p>
            </div>
          </div>
        </div>

        <!-- Quick Execution Footer Badges -->
        <div class="pt-3 border-t border-[var(--color-border)] flex items-center justify-between text-xs font-mono text-[var(--color-text-tertiary)]">
          <span class="flex items-center space-x-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Benchmark: &lt;15ms execution time</span>
          </span>
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Standalone .EXE</span>
        </div>
      </div>

    </div>

<script>
  const pvTabs = document.querySelectorAll('[data-pv-tab]');
  const pvPanes = document.querySelectorAll('.pv-tab-pane');

  pvTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-pv-tab');

      pvTabs.forEach((t) => {
        t.classList.remove('bg-zinc-800', 'text-emerald-400', 'font-bold');
        t.classList.add('text-zinc-400');
      });
      tab.classList.add('bg-zinc-800', 'text-emerald-400', 'font-bold');
      tab.classList.remove('text-zinc-400');

      pvPanes.forEach((p) => p.classList.add('hidden'));
      const activePane = document.getElementById(`pv-pane-${target}`);
      if (activePane) activePane.classList.remove('hidden');
    });
  });
</script>
