---
import projects from '../data/projects.json';

const portview = projects.find((p) => p.id === 'portview') || projects[0];
---

<section id="portview" class="py-16 md:py-24 border-b border-[var(--color-border)] bg-[var(--bg-gradient-section)] transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded border border-[var(--color-badge-emerald-border)] bg-[var(--color-badge-emerald-bg)] text-[var(--color-badge-emerald-text)] text-xs font-mono mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>// FLAGSHIP C++ SYSTEM TOOL</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)] flex items-center gap-3">
          <span>{portview.name}</span>
          <span class="text-xs font-mono font-normal px-2.5 py-1 rounded-full bg-[var(--color-badge-emerald-bg)] border border-[var(--color-badge-emerald-border)] text-[var(--color-badge-emerald-text)]">
            C++ / Windows SDK
          </span>
        </h2>
      </div>
      <div class="mt-4 md:mt-0">
        <a
          href={portview.github_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-[var(--color-bg-surface)] hover:bg-[var(--color-bg-surface-hover)] border border-[var(--color-border)] text-emerald-600 dark:text-emerald-400 text-sm font-mono transition-all shadow-sm"
        >
          <span>View Source on GitHub</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Main Showcase Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Problem & Architecture -->
      <div class="lg:col-span-7 space-y-6">
        <div class="p-6 sm:p-8 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] space-y-4 shadow-sm">
          <h3 class="text-xl font-bold text-[var(--color-text-primary)] flex items-center space-x-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-mono">01.</span>
            <span>System Overview & One-Liner</span>
          </h3>
          <p class="text-[var(--color-text-secondary)] text-base leading-relaxed">
            {portview.one_liner}
          </p>
          <div class="pt-2 flex flex-wrap gap-2">
            {portview.tech_stack?.map((tech) => (
              <span class="px-2.5 py-1 rounded bg-[var(--color-bg-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-secondary)] text-xs font-mono">
                {tech}
              </span>
            ))}
            <span class="px-2.5 py-1 rounded bg-[var(--color-badge-emerald-bg)] border border-[var(--color-badge-emerald-border)] text-[var(--color-badge-emerald-text)] text-xs font-mono">
              MIT License
            </span>
          </div>
        </div>

        <!-- Architecture Flow Diagram (SVG) -->
        <div class="p-6 sm:p-8 rounded-2xl bg-[var(--color-bg-surface)] border border-emerald-500/30 dark:border-emerald-500/20 space-y-4 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] flex items-center space-x-2">
              <span class="text-emerald-600 dark:text-emerald-400 font-mono">02.</span>
              <span>Low-Level Architecture Flow</span>
            </h3>
            <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              Zero Dependencies
            </span>
          </div>

          <div class="p-3 rounded-xl bg-zinc-950/80 border border-zinc-800 text-zinc-300 font-mono text-xs overflow-x-auto">
            <svg class="w-full min-w-[500px] h-36" viewBox="0 0 600 130" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Flow Nodes -->
              <!-- Node 1: CLI Args -->
              <rect x="10" y="35" width="100" height="60" rx="8" fill="#18181b" stroke="#3f3f46" stroke-width="1.5"/>
              <text x="60" y="60" text-anchor="middle" fill="#10b981" font-size="11" font-weight="bold" font-family="monospace">CLI Input</text>
              <text x="60" y="78" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="monospace">--stats --pid</text>

              <!-- Arrow 1 -->
              <path d="M110 65 L138 65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="142,65 135,61 135,69" fill="#10b981"/>

              <!-- Node 2: Win32 API -->
              <rect x="145" y="35" width="125" height="60" rx="8" fill="#18181b" stroke="#059669" stroke-width="1.5"/>
              <text x="207" y="60" text-anchor="middle" fill="#34d399" font-size="11" font-weight="bold" font-family="monospace">IPHLPAPI</text>
              <text x="207" y="78" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="monospace">GetExtendedTcpTable</text>

              <!-- Arrow 2 -->
              <path d="M270 65 L298 65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="302,65 295,61 295,69" fill="#10b981"/>

              <!-- Node 3: Socket Resolver -->
              <rect x="305" y="35" width="130" height="60" rx="8" fill="#18181b" stroke="#0891b2" stroke-width="1.5"/>
              <text x="370" y="60" text-anchor="middle" fill="#22d3ee" font-size="11" font-weight="bold" font-family="monospace">Process Mapping</text>
              <text x="370" y="78" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="monospace">PID → QueryName</text>

              <!-- Arrow 3 -->
              <path d="M435 65 L463 65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
              <polygon points="467,65 460,61 460,69" fill="#10b981"/>

              <!-- Node 4: Stream Output -->
              <rect x="470" y="35" width="115" height="60" rx="8" fill="#18181b" stroke="#3f3f46" stroke-width="1.5"/>
              <text x="527" y="60" text-anchor="middle" fill="#38bdf8" font-size="11" font-weight="bold" font-family="monospace">CLI Stream</text>
              <text x="527" y="78" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="monospace">Tabular Output</text>
            </svg>
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] space-y-4 shadow-sm">
          <h3 class="text-xl font-bold text-[var(--color-text-primary)] flex items-center space-x-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-mono">03.</span>
            <span>Key Engineering Capabilities</span>
          </h3>
          <ul class="space-y-3 text-sm text-[var(--color-text-secondary)]">
            <li class="flex items-start space-x-3">
              <span class="text-emerald-500 mt-0.5">▹</span>
              <span><strong>Live Socket Enumeration:</strong> Queries TCP/UDP connection tables directly using Windows IP Helper API (<code class="text-emerald-600 dark:text-emerald-300 font-mono text-xs">IPHLPAPI</code>).</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-emerald-500 mt-0.5">▹</span>
              <span><strong>PID Process Mapping:</strong> Resolves owner Process IDs to active process executable paths in real time.</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-emerald-500 mt-0.5">▹</span>
              <span><strong>Traffic Inspection & Stats:</strong> Tracks per-connection byte transfer rates and connection states.</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-emerald-500 mt-0.5">▹</span>
              <span><strong>Zero External Dependencies:</strong> Native C++ binary compiled directly against the Windows SDK.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Interactive Terminal Preview & CLI Inspector -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div class="rounded-2xl border border-zinc-800 bg-zinc-950 shadow-2xl overflow-hidden font-mono text-xs flex flex-col glow-border hover:border-emerald-500/40 transition-all duration-300">
          <!-- Terminal Titlebar & Command Tabs -->
          <div class="bg-zinc-900 px-4 py-3 border-b border-zinc-800 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="w-3 h-3 rounded-full bg-red-500/90 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/90 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/90 inline-block"></span>
            </div>
            <div class="flex items-center space-x-1 bg-zinc-950 p-1 rounded-lg border border-zinc-800 text-[11px]">
              <button
                type="button"
                data-pv-tab="scan"
                class="pv-tab-btn px-2.5 py-0.5 rounded bg-zinc-800 text-emerald-400 font-bold transition-all cursor-pointer"
              >
                --stats
              </button>
              <button
                type="button"
                data-pv-tab="pid"
                class="pv-tab-btn px-2.5 py-0.5 rounded text-zinc-400 hover:text-zinc-200 transition-all cursor-pointer"
              >
                --pid
              </button>
              <button
                type="button"
                data-pv-tab="help"
                class="pv-tab-btn px-2.5 py-0.5 rounded text-zinc-400 hover:text-zinc-200 transition-all cursor-pointer"
              >
                --help
              </button>
            </div>
          </div>

          <!-- Terminal Screen Body -->
          <div class="p-5 font-mono text-zinc-300 min-h-[300px] flex flex-col justify-between space-y-4">
            <!-- Tab 1: --stats view -->
            <div id="pv-pane-scan" class="pv-tab-pane space-y-2.5">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-bold">portview.exe --stats</span>
              </div>
              <p class="text-zinc-500 text-[11px]">Enumerating active network endpoints via IPHLPAPI...</p>
              <div class="border-t border-zinc-800/80 pt-2 font-mono text-[11px] space-y-1">
                <div class="text-zinc-500 font-bold flex justify-between">
                  <span>PROTO / ENDPOINT</span>
                  <span>STATE</span>
                  <span>SPEED</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-cyan-400">TCP</strong> 0.0.0.0:8080</span>
                  <span class="text-emerald-400 font-semibold">LISTENING</span>
                  <span class="text-zinc-500">0 B/s</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-cyan-400">TCP</strong> 192.168.1.5:443</span>
                  <span class="text-emerald-400 font-semibold">ESTABLISHED</span>
                  <span class="text-emerald-300">1.4 MB/s</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-cyan-400">TCP</strong> 192.168.1.5:22</span>
                  <span class="text-emerald-400 font-semibold">ESTABLISHED</span>
                  <span class="text-emerald-300">42 KB/s</span>
                </div>
                <div class="flex justify-between items-center text-zinc-300">
                  <span><strong class="text-yellow-400">UDP</strong> 0.0.0.0:53</span>
                  <span class="text-zinc-400 font-semibold">STATELESS</span>
                  <span class="text-zinc-500">2.1 KB/s</span>
                </div>
              </div>
              <div class="pt-2 text-emerald-400 font-bold text-[11px] flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>[OK] Zero-packet drop rate · Polling latency &lt;0.4ms</span>
              </div>
            </div>

            <!-- Tab 2: --pid view -->
            <div id="pv-pane-pid" class="pv-tab-pane hidden space-y-2.5">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-bold">portview.exe --pid --all</span>
              </div>
              <p class="text-zinc-500 text-[11px]">Resolving socket owners using QueryFullProcessImageNameW...</p>
              <div class="border-t border-zinc-800/80 pt-2 font-mono text-[11px] space-y-1">
                <div class="text-zinc-500 font-bold flex justify-between">
                  <span>PID / PROCESS</span>
                  <span>PORT</span>
                  <span>BOUND IP</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">4212 <span class="text-zinc-400">nginx.exe</span></span>
                  <span class="text-cyan-300 font-mono">:8080</span>
                  <span class="text-zinc-400">127.0.0.1</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">8190 <span class="text-zinc-400">chrome.exe</span></span>
                  <span class="text-cyan-300 font-mono">:443</span>
                  <span class="text-zinc-400">192.168.1.5</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">9012 <span class="text-zinc-400">sshd.exe</span></span>
                  <span class="text-cyan-300 font-mono">:22</span>
                  <span class="text-zinc-400">0.0.0.0</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-emerald-300">1044 <span class="text-zinc-400">svchost.exe</span></span>
                  <span class="text-cyan-300 font-mono">:53</span>
                  <span class="text-zinc-400">127.0.0.53</span>
                </div>
              </div>
              <div class="pt-2 text-cyan-400 font-semibold text-[11px]">
                ✔ 4 processes matched with elevated user privileges.
              </div>
            </div>

            <!-- Tab 3: --help view -->
            <div id="pv-pane-help" class="pv-tab-pane hidden space-y-2 text-[11px]">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-bold">portview.exe --help</span>
              </div>
              <p class="text-zinc-400">PORTVIEW v1.2 — High-Performance Windows Socket Inspector</p>
              <div class="border-t border-zinc-800/80 pt-2 space-y-1 text-zinc-300 font-mono">
                <p><span class="text-emerald-400 font-bold">-s, --stats</span>   Display live bandwidth &amp; transfer metrics</p>
                <p><span class="text-emerald-400 font-bold">-p, --pid</span>     Resolve PID to process name &amp; binary path</p>
                <p><span class="text-emerald-400 font-bold">-f, --filter</span>  Filter by protocol (tcp4, tcp6, udp4, udp6)</p>
                <p><span class="text-emerald-400 font-bold">-j, --json</span>    Output telemetry as NDJSON / structured data</p>
              </div>
              <p class="text-zinc-500 pt-2 text-[10px]">Zero external runtimes or DLL dependencies required.</p>
            </div>

            <!-- Bottom Prompt Line -->
            <div class="pt-3 border-t border-zinc-900 flex items-center justify-between text-[11px]">
              <div class="flex items-center space-x-2 text-emerald-400">
                <span>C:\tools></span>
                <span class="text-zinc-100 font-semibold animate-pulse">_</span>
              </div>
              <span class="text-zinc-600 font-mono text-[10px]">Win32 Native · MSVC x64</span>
            </div>
          </div>

          <!-- Bottom Status Bar -->
          <div class="p-3.5 bg-zinc-900/80 border-t border-zinc-800/80 text-zinc-400 text-xs flex justify-between items-center">
            <div class="flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-mono text-zinc-300">Target: Windows 10/11, Server</span>
            </div>
            <a
              href="https://github.com/mrun1corn/portview"
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-400 hover:text-emerald-300 font-mono font-semibold flex items-center space-x-1"
            >
              <span>GitHub Repo</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Quick Capability Cards below the terminal -->
        <div class="grid grid-cols-2 gap-3 mt-4">
          <div class="p-3.5 rounded-xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] shadow-sm">
            <div class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold uppercase">Performance</div>
            <div class="text-xs font-bold text-[var(--color-text-primary)] mt-0.5">&lt; 15ms Execution</div>
            <div class="text-[11px] text-[var(--color-text-tertiary)] mt-1">Direct kernel memory read without WMI overhead.</div>
          </div>
          <div class="p-3.5 rounded-xl bg-[var(--color-bg-surface)] border border-[var(--color-border)] shadow-sm">
            <div class="text-[11px] font-mono text-cyan-600 dark:text-cyan-400 font-semibold uppercase">Portability</div>
            <div class="text-xs font-bold text-[var(--color-text-primary)] mt-0.5">Single Portable .EXE</div>
            <div class="text-[11px] text-[var(--color-text-tertiary)] mt-1">Zero runtime or VC++ redistributable setup needed.</div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const pvTabs = document.querySelectorAll('[data-pv-tab]');
  const pvPanes = document.querySelectorAll('.pv-tab-pane');

  pvTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-pv-tab');

      pvTabs.forEach((t) => {
        t.classList.remove('bg-zinc-800', 'text-emerald-400', 'font-bold');
        t.classList.add('text-zinc-400');
      });
      tab.classList.add('bg-zinc-800', 'text-emerald-400', 'font-bold');
      tab.classList.remove('text-zinc-400');

      pvPanes.forEach((p) => p.classList.add('hidden'));
      const activePane = document.getElementById(`pv-pane-${target}`);
      if (activePane) activePane.classList.remove('hidden');
    });
  });
</script>
