---
import profile from '../data/profile.json';

interface Props {
  publicId?: string;
}

const { publicId = 'frm_7f21a6920aa2' } = Astro.props;
const submitUrl = `https://form.mrun1corn.xyz/api/forms/${publicId}/submit`;
const apiUrl = `https://form.mrun1corn.xyz/api/forms/${publicId}`;
---

<section id="contact" class="py-16 md:py-24 bg-[var(--bg-gradient-section-alt)] border-t border-[var(--color-border)]/80 transition-all duration-300">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full border border-[var(--color-badge-emerald-border)] bg-[var(--color-badge-emerald-bg)] text-[var(--color-badge-emerald-text)] text-xs font-mono">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
      <span>AVAILABLE FOR C++ & SERVER ADMINISTRATION ROLES</span>
    </div>

    <div class="space-y-3">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Let's Connect & Collaborate
      </h2>
      <p class="text-[var(--color-text-secondary)] text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
        Interested in discussing C++ software development, Linux server management, virtualization, network infrastructure, or engineering opportunities?
      </p>
    </div>

    <!-- Contact cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto pt-4">
      
      <!-- Email card with copy feature -->
      <div
        id="copy-email-btn"
        class="interactive-card p-5 rounded-2xl flex flex-col justify-between text-center cursor-pointer group hover:border-emerald-500/50 border"
      >
        <div class="text-emerald-500 dark:text-emerald-400 text-2xl mb-2 group-hover:scale-110 transition-transform">✉</div>
        <div class="text-xs text-[var(--color-text-tertiary)] font-mono">Email Contact</div>
        <div class="text-xs font-mono font-semibold text-[var(--color-text-primary)] truncate mt-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-300">
          {profile.contact.email}
        </div>
        <div id="email-toast" class="mt-2 text-[10px] font-mono text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity">
          ✓ Copied to clipboard!
        </div>
      </div>

      <!-- GitHub card -->
      <a
        href={profile.contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="interactive-card p-5 rounded-2xl flex flex-col justify-between text-center group hover:border-emerald-500/50 border"
      >
        <div class="text-emerald-500 dark:text-emerald-400 text-2xl mb-2 group-hover:scale-110 transition-transform">🐙</div>
        <div class="text-xs text-[var(--color-text-tertiary)] font-mono">GitHub Profile</div>
        <div class="text-xs font-mono font-semibold text-[var(--color-text-primary)] truncate mt-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-300">
          github.com/mrun1corn
        </div>
        <div class="mt-2 text-[10px] font-mono text-[var(--color-text-tertiary)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400/80 transition-colors">
          View Repos ↗
        </div>
      </a>

      <!-- X / Twitter card -->
      <a
        href={profile.contact.twitter}
        target="_blank"
        rel="noopener noreferrer"
        class="interactive-card p-5 rounded-2xl flex flex-col justify-between text-center group hover:border-emerald-500/50 border"
      >
        <div class="text-emerald-500 dark:text-emerald-400 text-2xl mb-2 group-hover:scale-110 transition-transform">𝕏</div>
        <div class="text-xs text-[var(--color-text-tertiary)] font-mono">Twitter / X</div>
        <div class="text-xs font-mono font-semibold text-[var(--color-text-primary)] truncate mt-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-300">
          @Robin33090740
        </div>
        <div class="mt-2 text-[10px] font-mono text-[var(--color-text-tertiary)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400/80 transition-colors">
          Follow ↗
        </div>
      </a>

    </div>

    <!-- Contact form with Live Google Map Layout -->
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch font-sans text-left">
      <!-- Left Column: Interactive Form -->
      <div class="p-6 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
        <div id="astro-alert" class="hidden p-4 rounded-lg text-sm mb-4"></div>

        <form id="astro-contact-form" class="space-y-4">
          <!-- Anti-spam honeypot -->
          <input type="text" name="_hp_bio_field" class="hidden" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_bcf_ts" id="astro-bcf-ts" value="" />

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">Your Name *</label>
            <input type="text" name="name" id="astro-name" required placeholder="John Doe" class="w-full px-3 py-2 border rounded-lg bg-slate-50 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 transition" />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">Email Address *</label>
            <input type="email" name="email" id="astro-email" required placeholder="john@example.com" class="w-full px-3 py-2 border rounded-lg bg-slate-50 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 transition" />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">Country *</label>
            <select name="country" id="astro-country" data-country-select required class="w-full px-3 py-2 border rounded-lg bg-slate-50 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 transition">
              <option value="">-- Select Country --</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">Phone Number *</label>
            <div class="flex gap-2 items-stretch">
              <span id="astro-dial-badge" class="inline-flex items-center justify-center px-3 bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 select-none min-w-[54px]">+1</span>
              <input type="tel" name="phone" id="astro-phone" placeholder="+1 (555) 000-0000" required class="flex-1 w-full px-3 py-2 border rounded-lg bg-slate-50 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 transition" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1">Your Message *</label>
            <textarea name="message" id="astro-message" rows={4} required placeholder="How can I help you?" class="w-full px-3 py-2 border rounded-lg bg-slate-50 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 transition"></textarea>
          </div>

          <button type="submit" id="astro-submit-btn" class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow transition duration-150 disabled:opacity-50">
            Send Message
          </button>

          <!-- BITSS branding footer -->
          <div class="mt-6 pt-5 border-t border-slate-200 dark:border-slate-800 text-center font-sans">
            <img src="https://form.mrun1corn.xyz/assets/image.png" alt="BITSS Cyber Security" class="h-10 w-auto mx-auto mb-2 object-contain" />
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-0.5">This form is powered by <strong>BITSS Cyber Security</strong></p>
            <p class="text-[11px] text-slate-400 dark:text-slate-500">&copy; {new Date().getFullYear()} BFIN. BITSS by BFIN. All rights reserved.</p>
          </div>
        </form>
      </div>

      <!-- Right Column: Live Google Map -->
      <div id="astro-map-wrapper" class="w-full flex flex-col h-full min-h-[360px] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-sm">
        <iframe
          id="astro-map-iframe"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3651.6336418306787!2d90.3627956!3d23.7604404!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755bf58f978a217%3A0x92b804bef87dea46!2s23%2C%202%20Razia%20Sultana%20Rd%2C%20Dhaka!5e0!3m2!1sen!2sbd!4v1787124650061!5m2!1sen!2sbd"
          width="100%"
          height="100%"
          class="w-full h-full min-h-[340px] flex-1 rounded-lg border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div id="astro-map-address" class="mt-2 px-2 py-1 text-xs text-slate-500 dark:text-slate-400 font-medium text-left">
          📍 23, 2 Razia Sultana Rd, Mohammadpur, Dhaka
        </div>
      </div>
    </div>

    <script define:vars={{ submitUrl, apiUrl }}>
      document.getElementById('astro-bcf-ts').value = Date.now();

      const countrySelect = document.getElementById('astro-country');
      const phoneInput = document.getElementById('astro-phone');
      const dialBadge = document.getElementById('astro-dial-badge');
      const mapIframe = document.getElementById('astro-map-iframe');
      const mapAddress = document.getElementById('astro-map-address');

      let countryData = [];

      // Function to sync phone dialing code with active country
      function syncDialCode(dialCode) {
        if (!dialCode) return;
        if (dialBadge) dialBadge.textContent = dialCode;
        if (phoneInput) {
          const currentVal = phoneInput.value.trim();
          if (!currentVal || phoneInput.dataset.autoPrefilled === 'true') {
            phoneInput.value = dialCode + ' ';
            phoneInput.dataset.autoPrefilled = 'true';
          } else if (currentVal.startsWith('+')) {
            const match = currentVal.match(/^\+\d+\s*(.*)$/);
            const rest = match ? match[1] : '';
            phoneInput.value = dialCode + (rest ? ' ' + rest : ' ');
          }
        }
      }

      // Dynamically load countries & form settings from API
      fetch(apiUrl)
        .then((res) => res.json())
        .then((data) => {
          if (data.success && data.form) {
            // 1. Update Map iframe if settings returned
            const mapSettings = data.form.schema?.settings?.map;
            if (mapSettings && mapSettings.enabled && mapSettings.embed_url && mapIframe) {
              mapIframe.src = mapSettings.embed_url;
              if (mapSettings.address_text && mapAddress) {
                mapAddress.textContent = '📍 ' + mapSettings.address_text;
              }
            }

            // 2. Populate Country dropdown
            if (data.form.countries && countrySelect) {
              countryData = data.form.countries;
              countrySelect.innerHTML = '<option value="">-- Select Country --</option>';
              data.form.countries.forEach((country) => {
                const flag = country.flag ? `${country.flag} ` : '';
                const dial = country.dial_code ? ` (${country.dial_code})` : '';
                const option = document.createElement('option');
                option.value = country.name;
                option.setAttribute('data-dial', country.dial_code || '+1');
                option.setAttribute('data-iso', country.iso2 || '');
                option.textContent = `${flag}${country.name}${dial}`;
                countrySelect.appendChild(option);
              });
            }
          }
        })
        .catch(() => {});

      // Auto-update phone dialing code when user changes country
      if (countrySelect) {
        countrySelect.addEventListener('change', () => {
          const selectedOpt = countrySelect.selectedOptions[0];
          if (selectedOpt) {
            const dial = selectedOpt.getAttribute('data-dial');
            if (dial) syncDialCode(dial);
          }
        });
      }

      const form = document.getElementById('astro-contact-form');
      const alertBox = document.getElementById('astro-alert');
      const submitBtn = document.getElementById('astro-submit-btn');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const response = await fetch(submitUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await response.json();

          alertBox.classList.remove(
            'hidden',
            'bg-red-50',
            'text-red-700',
            'border-red-200',
            'bg-emerald-50',
            'text-emerald-700',
            'border-emerald-200'
          );

          if (response.ok && data.success) {
            alertBox.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
            alertBox.textContent = data.message || 'Thank you! Your message has been sent.';
            form.reset();
            if (dialBadge) dialBadge.textContent = '+1';
          } else {
            alertBox.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
            alertBox.textContent = data.message || 'Submission failed.';
          }
        } catch {
          alertBox.classList.remove('hidden');
          alertBox.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
          alertBox.textContent = 'Network error. Please try again.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      });
    </script>
    <!-- Footer copyright -->
    <div class="pt-12 border-t border-[var(--color-border)]/60 text-xs text-[var(--color-text-tertiary)] font-mono flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        © {new Date().getFullYear()} Robin Mia (@mrun1corn). All rights reserved.
      </div>
      <div class="flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Astro + Tailwind CSS</span>
      </div>
    </div>

  </div>
</section>

<script>
  const emailBtn = document.getElementById('copy-email-btn');
  const toast = document.getElementById('email-toast');

  if (emailBtn && toast) {
    emailBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('robin424123@gmail.com');
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
      }, 2000);
    });
  }
</script>
