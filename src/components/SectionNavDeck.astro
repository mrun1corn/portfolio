---
interface SectionPreview {
  id: string;
  num: string;
  label: string;
  tag: string;
  description: string;
  stack: string;
  previewType: 'hero' | 'infra' | 'net' | 'portview' | 'projects' | 'timeline' | 'contact';
}

const sections: SectionPreview[] = [
  {
    id: 'hero',
    num: '01',
    label: 'Overview',
    tag: '// PROFILE & IDENTITY',
    description: 'C++ Developer & Server Administrator profile',
    stack: 'C++ · Linux · Server Admin',
    previewType: 'hero',
  },
  {
    id: 'infrastructure',
    num: '02',
    label: 'Infrastructure',
    tag: '// SYSTEMS & VIRTUALIZATION',
    description: 'Hypervisors, Linux servers, RAID & VMs',
    stack: 'Proxmox VE · VMware · Ubuntu',
    previewType: 'infra',
  },
  {
    id: 'networking',
    num: '03',
    label: 'Networking',
    tag: '// NETWORK & SECURITY',
    description: 'Mikrotik & Cisco routing, firewall policies',
    stack: 'Mikrotik · Cisco · Firewall',
    previewType: 'net',
  },
  {
    id: 'portview',
    num: '04',
    label: 'portview (C++)',
    tag: '// FLAGSHIP C++ SYSTEM TOOL',
    description: 'Win32 socket monitor & PID process mapper',
    stack: 'Win32 API · C++ · IPHLPAPI',
    previewType: 'portview',
  },
  {
    id: 'projects',
    num: '05',
    label: 'Projects',
    tag: '// GITHUB REPOSITORIES',
    description: 'Pinned open-source software and tools',
    stack: 'Open Source · GitHub',
    previewType: 'projects',
  },
  {
    id: 'experience',
    num: '06',
    label: 'Experience',
    tag: '// CAREER & EDUCATION',
    description: 'Work history at BFIN IT, Joy Cinemas & ALO',
    stack: '3+ Years · BSc CSE',
    previewType: 'timeline',
  },
  {
    id: 'contact',
    num: '07',
    label: 'Contact',
    tag: '// DIRECT CHANNELS',
    description: 'Direct message form & email contact',
    stack: 'Available for Roles',
    previewType: 'contact',
  },
];
---

<!-- Permanently Visible Right-Side Stack Overview (Desktop xl+) -->
<aside
  id="section-nav-deck"
  aria-label="Stack Overview Section Navigator"
  class="fixed right-6 2xl:right-10 top-1/2 -translate-y-1/2 z-40 hidden xl:flex flex-col items-end select-none font-mono pointer-events-auto"
>
  <!-- Card Stack Column -->
  <nav class="flex flex-col space-y-2.5 w-52 2xl:w-60">
    {sections.map((sec) => (
      <div class="relative group/stack flex items-center justify-end">
        
        <!-- Hover Popout Preview Card (Slides in to the left with frosted blur snapshot) -->
        <div
          class="stack-popout-preview absolute right-full mr-3 top-1/2 -translate-y-1/2 w-72 p-4 rounded-2xl bg-[var(--color-bg-base)]/95 dark:bg-zinc-950/95 backdrop-blur-2xl border border-[var(--color-border)] shadow-2xl opacity-0 pointer-events-none group-hover/stack:opacity-100 group-hover/stack:pointer-events-auto transition-all duration-200 transform translate-x-2 group-hover/stack:translate-x-0 z-50 text-left"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400">
              {sec.tag}
            </span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--color-bg-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-tertiary)] font-bold">
              {sec.num}
            </span>
          </div>

          <h4 class="text-xs font-bold text-[var(--color-text-primary)] mb-1">
            {sec.label}
          </h4>

          <p class="text-[11px] text-[var(--color-text-secondary)] leading-relaxed mb-3">
            {sec.description}
          </p>

          <!-- Miniature Live Snapshot Mockup -->
          <div class="relative w-full h-16 rounded-lg overflow-hidden border border-zinc-800 bg-zinc-950 p-2 text-[9px] text-zinc-300 font-mono shadow-inner mb-3">
            {sec.previewType === 'hero' && (
              <div class="h-full flex items-center justify-between">
                <div class="space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[9px]">Robin Mia (@mrun1corn)</div>
                  <div class="text-zinc-400 text-[7.5px]">C++ Dev & Server Admin</div>
                </div>
                <div class="w-20 h-full bg-zinc-900 rounded border border-zinc-800 p-1 text-[7px] flex flex-col justify-center">
                  <div class="text-emerald-400">$ whoami</div>
                  <div class="text-cyan-300 truncate">mrun1corn</div>
                </div>
              </div>
            )}

            {sec.previewType === 'infra' && (
              <div class="h-full flex items-center gap-1">
                <div class="flex-1 bg-zinc-900 rounded border border-zinc-800 p-1 text-center">
                  <div class="text-emerald-400 font-bold text-[7.5px]">Proxmox</div>
                  <div class="text-[6.5px] text-zinc-400">Hypervisor</div>
                </div>
                <div class="flex-1 bg-zinc-900 rounded border border-zinc-800 p-1 text-center">
                  <div class="text-emerald-400 font-bold text-[7.5px]">Ubuntu</div>
                  <div class="text-[6.5px] text-zinc-400">Server OS</div>
                </div>
                <div class="flex-1 bg-zinc-900 rounded border border-zinc-800 p-1 text-center">
                  <div class="text-emerald-400 font-bold text-[7.5px]">RAID/VM</div>
                  <div class="text-[6.5px] text-zinc-400">Storage</div>
                </div>
              </div>
            )}

            {sec.previewType === 'net' && (
              <div class="h-full flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <div class="text-cyan-400 font-bold text-[8px]">Mikrotik & Cisco</div>
                  <div class="text-[7px] text-zinc-400">Enterprise Routing & Firewall</div>
                </div>
                <div class="px-1.5 py-0.5 rounded bg-cyan-950 border border-cyan-800 text-cyan-300 font-bold text-[7px]">
                  🔒 Shield
                </div>
              </div>
            )}

            {sec.previewType === 'portview' && (
              <div class="h-full flex items-center justify-between">
                <div class="space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[8px]">portview.exe</div>
                  <div class="text-[7px] text-cyan-300">IPHLPAPI Socket Enum</div>
                </div>
                <div class="w-24 h-full bg-zinc-900 rounded border border-emerald-500/30 p-1 text-[6.5px] leading-tight text-zinc-400 flex flex-col justify-center">
                  <div class="text-emerald-300 font-bold">127.0.0.1:8080</div>
                  <div class="text-zinc-500 truncate">nginx.exe [4212]</div>
                </div>
              </div>
            )}

            {sec.previewType === 'projects' && (
              <div class="h-full flex items-center gap-1">
                <div class="flex-1 bg-zinc-900 rounded border border-purple-800/40 p-1 text-[7px]">
                  <div class="text-purple-400 font-bold">portview</div>
                  <div class="text-zinc-500">C++</div>
                </div>
                <div class="flex-1 bg-zinc-900 rounded border border-purple-800/40 p-1 text-[7px]">
                  <div class="text-purple-400 font-bold">Anyn0te</div>
                  <div class="text-zinc-500">App</div>
                </div>
              </div>
            )}

            {sec.previewType === 'timeline' && (
              <div class="h-full flex items-center justify-between px-1">
                <div class="border-l-2 border-emerald-500 pl-2 space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[7.5px]">BFIN IT (C++ Developer)</div>
                  <div class="text-zinc-400 text-[6.5px]">Joy Cinemas · ALO Comm</div>
                </div>
              </div>
            )}

            {sec.previewType === 'contact' && (
              <div class="h-full flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[8px]">Direct Message</div>
                  <div class="text-[7px] text-zinc-400">Available for Roles</div>
                </div>
                <div class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-400 text-[7.5px] font-bold">
                  ✉ Send
                </div>
              </div>
            )}
          </div>

          <div class="pt-2 border-t border-[var(--color-border)]/60 flex items-center justify-between text-[10px]">
            <span class="text-[var(--color-text-tertiary)] truncate max-w-[150px]">{sec.stack}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold flex items-center space-x-1">
              <span>Navigate</span>
              <span>↵</span>
            </span>
          </div>
        </div>

        <!-- Visible Stack Card Bar -->
        <a
          href={`#${sec.id}`}
          data-stack-target={sec.id}
          aria-label={`Jump to ${sec.label}`}
          class="stack-card w-full py-2 px-3 rounded-xl bg-[var(--color-bg-base)]/80 dark:bg-zinc-950/80 backdrop-blur-xl border border-[var(--color-border)] hover:border-emerald-500/60 dark:hover:border-emerald-400/60 hover:bg-[var(--color-bg-surface-hover)] dark:hover:bg-zinc-900 transition-all duration-200 flex items-center justify-between shadow-sm cursor-pointer group-hover/stack:shadow-md"
        >
          <div class="flex items-center space-x-2.5 overflow-hidden">
            <span class="stack-num text-[10px] font-bold px-1.5 py-0.5 rounded bg-[var(--color-bg-surface-hover)] dark:bg-zinc-900 border border-[var(--color-border)] text-[var(--color-text-tertiary)] group-hover/stack:text-emerald-500 transition-colors">
              {sec.num}
            </span>
            <span class="stack-label text-xs font-semibold text-[var(--color-text-primary)] group-hover/stack:text-emerald-600 dark:group-hover/stack:text-emerald-400 transition-colors truncate">
              {sec.label}
            </span>
          </div>

          <!-- Micro Pulse Indicator for Active State -->
          <span class="stack-indicator w-2 h-2 rounded-full bg-[var(--color-border)] transition-all"></span>
        </a>

      </div>
    ))}
  </nav>

  <!-- Wireframe Caption: "stack overview" -->
  <div class="mt-3 w-full flex items-center justify-between px-2 text-[11px] text-[var(--color-text-tertiary)] font-bold tracking-tight">
    <span class="flex items-center space-x-1 text-emerald-600 dark:text-emerald-400">
      <span>//</span>
      <span>stack overview</span>
    </span>
    <span id="stack-counter" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[var(--color-bg-surface-hover)] dark:bg-zinc-900 border border-[var(--color-border)]">
      01 / 07
    </span>
  </div>
</aside>

<script>
  const stackCards = document.querySelectorAll<HTMLAnchorElement>('.stack-card');
  const stackCounter = document.getElementById('stack-counter');

  const sectionMeta: Record<string, { num: string; label: string; index: number }> = {
    hero: { num: '01', label: 'Overview', index: 1 },
    infrastructure: { num: '02', label: 'Infrastructure', index: 2 },
    networking: { num: '03', label: 'Networking', index: 3 },
    portview: { num: '04', label: 'portview (C++)', index: 4 },
    projects: { num: '05', label: 'Projects', index: 5 },
    experience: { num: '06', label: 'Experience', index: 6 },
    contact: { num: '07', label: 'Contact', index: 7 },
  };

  const sectionElements: HTMLElement[] = [];
  Object.keys(sectionMeta).forEach((id) => {
    const el = document.getElementById(id);
    if (el) sectionElements.push(el);
  });

  function updateActiveStack(currentId: string) {
    const meta = sectionMeta[currentId];
    if (meta && stackCounter) {
      stackCounter.textContent = `${meta.num} / 07`;
    }

    stackCards.forEach((card) => {
      const target = card.getAttribute('data-stack-target');
      const indicator = card.querySelector('.stack-indicator');
      const numBadge = card.querySelector('.stack-num');
      const label = card.querySelector('.stack-label');

      if (target === currentId) {
        card.classList.add(
          'border-emerald-500',
          'dark:border-emerald-400',
          'bg-emerald-500/10',
          'dark:bg-emerald-500/15',
          'shadow-md',
          'shadow-emerald-500/15',
          '-translate-x-2'
        );
        indicator?.classList.add('bg-emerald-500', 'animate-pulse', 'scale-125');
        indicator?.classList.remove('bg-[var(--color-border)]');
        numBadge?.classList.add('bg-emerald-500', 'text-zinc-950', 'border-emerald-400');
        label?.classList.add('text-emerald-600', 'dark:text-emerald-400', 'font-bold');
      } else {
        card.classList.remove(
          'border-emerald-500',
          'dark:border-emerald-400',
          'bg-emerald-500/10',
          'dark:bg-emerald-500/15',
          'shadow-md',
          'shadow-emerald-500/15',
          '-translate-x-2'
        );
        indicator?.classList.remove('bg-emerald-500', 'animate-pulse', 'scale-125');
        indicator?.classList.add('bg-[var(--color-border)]');
        numBadge?.classList.remove('bg-emerald-500', 'text-zinc-950', 'border-emerald-400');
        label?.classList.remove('text-emerald-600', 'dark:text-emerald-400', 'font-bold');
      }
    });
  }

  // Active Section Observer
  if (sectionElements.length > 0) {
    const observerOptions: IntersectionObserverInit = {
      root: null,
      rootMargin: '-20% 0px -50% 0px',
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveStack(entry.target.id);
        }
      });
    }, observerOptions);

    sectionElements.forEach((sec) => observer.observe(sec));
  }

  // Smooth scroll handler with header offset
  stackCards.forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const targetId = anchor.getAttribute('href')?.substring(1);
      if (!targetId) return;
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        e.preventDefault();
        const headerOffset = 70;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth',
        });

        updateActiveStack(targetId);
      }
    });
  });
</script>
