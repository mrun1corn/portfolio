---
interface SectionPreview {
  id: string;
  num: string;
  label: string;
  tag: string;
  description: string;
  badge: string;
  previewType: 'hero' | 'infra' | 'net' | 'portview' | 'projects' | 'timeline' | 'contact';
}

const sections: SectionPreview[] = [
  {
    id: 'hero',
    num: '01',
    label: 'Overview',
    tag: '// PROFILE & IDENTITY',
    description: 'C++ Developer & Server Administrator overview',
    badge: 'C++ · Linux · Server Admin',
    previewType: 'hero',
  },
  {
    id: 'infrastructure',
    num: '02',
    label: 'Infrastructure',
    tag: '// SYSTEMS & VIRTUALIZATION',
    description: 'Hypervisors, Linux servers, RAID & VMs',
    badge: 'Proxmox VE · VMware · Ubuntu',
    previewType: 'infra',
  },
  {
    id: 'networking',
    num: '03',
    label: 'Networking',
    tag: '// NETWORK & SECURITY',
    description: 'Mikrotik & Cisco routing, firewall policies',
    badge: 'Mikrotik · Cisco · Firewall',
    previewType: 'net',
  },
  {
    id: 'portview',
    num: '04',
    label: 'portview (C++)',
    tag: '// FLAGSHIP C++ SYSTEM TOOL',
    description: 'Win32 socket monitor & PID process mapper',
    badge: 'Win32 API · C++ · IPHLPAPI',
    previewType: 'portview',
  },
  {
    id: 'projects',
    num: '05',
    label: 'Projects',
    tag: '// GITHUB REPOSITORIES',
    description: 'Pinned open-source software and tools',
    badge: 'Open Source · GitHub',
    previewType: 'projects',
  },
  {
    id: 'experience',
    num: '06',
    label: 'Experience',
    tag: '// CAREER & EDUCATION',
    description: 'Work history at BFIN IT, Joy Cinemas & ALO',
    badge: '3+ Years · BSc CSE',
    previewType: 'timeline',
  },
  {
    id: 'contact',
    num: '07',
    label: 'Contact',
    tag: '// DIRECT CHANNELS',
    description: 'Direct message form & email contact',
    badge: 'Available for Roles',
    previewType: 'contact',
  },
];
---

<!-- Interactive Section Stack & Thumbnail Dock (Anchored at Bottom-Right) -->
<aside
  id="section-nav-deck"
  aria-label="Section Visual Navigator"
  class="fixed bottom-6 right-6 z-40 select-none flex flex-col items-end group/deck font-mono"
>
  <!-- Expanded Visual Thumbnail Stack (Fans out on hover / when open) -->
  <div
    id="deck-stack-container"
    class="mb-3 w-80 sm:w-96 max-h-[70vh] overflow-y-auto overflow-x-hidden p-3 rounded-2xl bg-[var(--color-bg-base)]/90 dark:bg-zinc-950/90 backdrop-blur-2xl border border-[var(--color-border)] shadow-2xl space-y-3 transition-all duration-300 opacity-0 scale-95 pointer-events-none group-hover/deck:opacity-100 group-hover/deck:scale-100 group-hover/deck:pointer-events-auto custom-deck-scroll"
  >
    <div class="flex items-center justify-between px-1 pb-2 border-b border-[var(--color-border)]/60 text-xs text-[var(--color-text-tertiary)]">
      <span class="flex items-center space-x-1.5 font-bold text-[var(--color-text-primary)]">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>SECTION NAVIGATOR</span>
      </span>
      <span class="text-[10px]">7 SECTIONS</span>
    </div>

    <!-- Thumbnail Cards List -->
    <div class="space-y-2.5">
      {sections.map((sec) => (
        <a
          href={`#${sec.id}`}
          data-section-target={sec.id}
          class="deck-card block p-3 rounded-xl bg-[var(--color-bg-surface)] dark:bg-zinc-900/80 border border-[var(--color-border)] hover:border-emerald-500/60 dark:hover:border-emerald-400/60 hover:bg-[var(--color-bg-surface-hover)] dark:hover:bg-zinc-900 transition-all duration-200 group/card relative overflow-hidden shadow-sm cursor-pointer"
        >
          <!-- Header Bar -->
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center space-x-2">
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                {sec.num}
              </span>
              <span class="text-xs font-bold text-[var(--color-text-primary)] group-hover/card:text-emerald-500 dark:group-hover/card:text-emerald-400 transition-colors">
                {sec.label}
              </span>
            </div>
            <span class="active-indicator hidden items-center space-x-1 text-[10px] font-bold text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              <span>LIVE</span>
            </span>
          </div>

          <!-- Miniature Section Visual Snapshot Mockup with Blur Backdrop -->
          <div class="relative w-full h-16 rounded-lg overflow-hidden border border-zinc-800/80 bg-zinc-950 p-2 text-[9px] text-zinc-300 font-mono shadow-inner group-hover/card:border-emerald-500/40 transition-colors">
            
            <!-- Hero Mockup -->
            {sec.previewType === 'hero' && (
              <div class="h-full flex items-center justify-between">
                <div class="space-y-1">
                  <div class="text-emerald-400 font-bold text-[10px] leading-tight">Robin Mia (@mrun1corn)</div>
                  <div class="text-zinc-400 text-[8px] truncate max-w-[150px]">C++ Dev & Server Admin</div>
                  <div class="text-[7px] text-zinc-500">BFIN IT · Dhaka</div>
                </div>
                <div class="w-24 h-full bg-zinc-900/90 rounded border border-zinc-800 p-1 text-[7px] flex flex-col justify-center space-y-0.5">
                  <div class="text-emerald-400 font-bold">$ whoami</div>
                  <div class="text-cyan-300 truncate">mrun1corn</div>
                </div>
              </div>
            )}

            <!-- Infrastructure Mockup -->
            {sec.previewType === 'infra' && (
              <div class="h-full flex items-center gap-1.5">
                <div class="flex-1 bg-zinc-900/90 rounded border border-zinc-800 p-1 text-center">
                  <div class="text-emerald-400 font-bold text-[8px]">Proxmox VE</div>
                  <div class="text-[7px] text-zinc-400">Hypervisor</div>
                </div>
                <div class="flex-1 bg-zinc-900/90 rounded border border-zinc-800 p-1 text-center">
                  <div class="text-emerald-400 font-bold text-[8px]">Linux Ubuntu</div>
                  <div class="text-[7px] text-zinc-400">Server OS</div>
                </div>
                <div class="flex-1 bg-zinc-900/90 rounded border border-zinc-800 p-1 text-center">
                  <div class="text-emerald-400 font-bold text-[8px]">RAID & VM</div>
                  <div class="text-[7px] text-zinc-400">Storage</div>
                </div>
              </div>
            )}

            <!-- Networking Mockup -->
            {sec.previewType === 'net' && (
              <div class="h-full flex items-center justify-between px-1">
                <div class="space-y-1">
                  <div class="text-cyan-400 font-bold text-[8px]">Mikrotik & Cisco</div>
                  <div class="text-[7px] text-zinc-400">Enterprise Routing & Firewall</div>
                </div>
                <div class="px-2 py-1 rounded bg-cyan-950/60 border border-cyan-800/80 text-cyan-300 font-bold text-[8px]">
                  🔒 Shield
                </div>
              </div>
            )}

            <!-- Portview Mockup -->
            {sec.previewType === 'portview' && (
              <div class="h-full flex items-center justify-between">
                <div class="space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[8px]">portview.exe (C++)</div>
                  <div class="text-[7px] text-zinc-400">IPHLPAPI Socket Enum</div>
                  <div class="text-[7px] text-cyan-300 font-mono">PID → Process Map</div>
                </div>
                <div class="w-28 h-full bg-zinc-900/90 rounded border border-emerald-500/30 p-1 text-[6.5px] leading-tight text-zinc-400 font-mono flex flex-col justify-center">
                  <div class="text-emerald-300 font-bold">TCP 127.0.0.1:8080</div>
                  <div class="text-zinc-500">nginx.exe [PID 4212]</div>
                </div>
              </div>
            )}

            <!-- Projects Mockup -->
            {sec.previewType === 'projects' && (
              <div class="h-full flex items-center gap-1.5">
                <div class="flex-1 bg-zinc-900/90 rounded border border-purple-800/40 p-1">
                  <div class="text-purple-400 font-bold text-[8px] truncate">portview</div>
                  <div class="text-[7px] text-zinc-500">C++ Tool</div>
                </div>
                <div class="flex-1 bg-zinc-900/90 rounded border border-purple-800/40 p-1">
                  <div class="text-purple-400 font-bold text-[8px] truncate">Anyn0te</div>
                  <div class="text-[7px] text-zinc-500">Full-stack</div>
                </div>
                <div class="flex-1 bg-zinc-900/90 rounded border border-purple-800/40 p-1">
                  <div class="text-purple-400 font-bold text-[8px] truncate">WAF Demo</div>
                  <div class="text-[7px] text-zinc-500">Security</div>
                </div>
              </div>
            )}

            <!-- Timeline Mockup -->
            {sec.previewType === 'timeline' && (
              <div class="h-full flex items-center justify-between px-1">
                <div class="border-l-2 border-emerald-500 pl-2 space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[8px]">BFIN IT (C++ Developer)</div>
                  <div class="text-zinc-400 text-[7px]">Joy Cinemas · ALO Comm</div>
                </div>
                <div class="text-[7px] text-zinc-500 font-mono">2022–Present</div>
              </div>
            )}

            <!-- Contact Mockup -->
            {sec.previewType === 'contact' && (
              <div class="h-full flex items-center justify-between px-1">
                <div class="space-y-0.5">
                  <div class="text-emerald-400 font-bold text-[8px]">Let's Connect</div>
                  <div class="text-[7px] text-zinc-400">Direct Message & Email</div>
                </div>
                <div class="px-2 py-1 rounded bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-bold text-[8px]">
                  ✉ Send
                </div>
              </div>
            )}

            <!-- Ambient Corner Glow in Card Preview -->
            <div class="absolute -right-3 -bottom-3 w-10 h-10 bg-emerald-500/10 rounded-full blur-md pointer-events-none"></div>
          </div>

          <!-- Bottom Micro Tag & Action -->
          <div class="mt-2 flex items-center justify-between text-[10px] text-[var(--color-text-tertiary)]">
            <span class="truncate max-w-[200px]">{sec.badge}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold group-hover/card:translate-x-0.5 transition-transform flex items-center space-x-0.5">
              <span>Jump</span>
              <span>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Bottom-Right Floating Trigger Button (Shows Active Section & Progress) -->
  <button
    id="deck-trigger-btn"
    type="button"
    aria-label="Toggle section navigator"
    class="flex items-center space-x-2.5 px-4 py-2.5 rounded-full bg-[var(--color-bg-base)]/90 dark:bg-zinc-950/90 backdrop-blur-xl border border-[var(--color-border)] hover:border-emerald-500/50 text-[var(--color-text-primary)] shadow-2xl transition-all duration-300 hover:scale-105 cursor-pointer group-hover/deck:border-emerald-500"
  >
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
    </span>

    <span id="deck-active-label" class="text-xs font-bold font-mono tracking-tight text-[var(--color-text-primary)]">
      01. Overview
    </span>

    <span class="text-[10px] font-mono text-[var(--color-text-tertiary)] bg-[var(--color-bg-surface-hover)] dark:bg-zinc-900 px-1.5 py-0.5 rounded border border-[var(--color-border)]">
      <span id="deck-active-index">1</span>/7
    </span>

    <svg class="w-3.5 h-3.5 text-[var(--color-text-tertiary)] group-hover/deck:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
    </svg>
  </button>
</aside>

<style>
  .custom-deck-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .custom-deck-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-deck-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }
  .custom-deck-scroll::-webkit-scrollbar-thumb:hover {
    background: #10b981;
  }
</style>

<script>
  const deckCards = document.querySelectorAll<HTMLAnchorElement>('.deck-card');
  const activeLabel = document.getElementById('deck-active-label');
  const activeIndex = document.getElementById('deck-active-index');

  const sectionMeta: Record<string, { num: string; label: string; index: number }> = {
    hero: { num: '01', label: 'Overview', index: 1 },
    infrastructure: { num: '02', label: 'Infrastructure', index: 2 },
    networking: { num: '03', label: 'Networking', index: 3 },
    portview: { num: '04', label: 'portview (C++)', index: 4 },
    projects: { num: '05', label: 'Projects', index: 5 },
    experience: { num: '06', label: 'Experience', index: 6 },
    contact: { num: '07', label: 'Contact', index: 7 },
  };

  const sectionElements: HTMLElement[] = [];
  Object.keys(sectionMeta).forEach((id) => {
    const el = document.getElementById(id);
    if (el) sectionElements.push(el);
  });

  function updateActiveDeck(currentId: string) {
    const meta = sectionMeta[currentId];
    if (meta && activeLabel && activeIndex) {
      activeLabel.textContent = `${meta.num}. ${meta.label}`;
      activeIndex.textContent = String(meta.index);
    }

    deckCards.forEach((card) => {
      const target = card.getAttribute('data-section-target');
      const liveBadge = card.querySelector('.active-indicator');
      if (target === currentId) {
        card.classList.add('border-emerald-500', 'dark:border-emerald-400', 'bg-[var(--color-bg-surface-hover)]', 'dark:bg-zinc-900', 'shadow-md', 'shadow-emerald-500/10');
        liveBadge?.classList.remove('hidden');
        liveBadge?.classList.add('inline-flex');
      } else {
        card.classList.remove('border-emerald-500', 'dark:border-emerald-400', 'bg-[var(--color-bg-surface-hover)]', 'dark:bg-zinc-900', 'shadow-md', 'shadow-emerald-500/10');
        liveBadge?.classList.remove('inline-flex');
        liveBadge?.classList.add('hidden');
      }
    });
  }

  // IntersectionObserver for active tracking
  if (sectionElements.length > 0) {
    const observerOptions: IntersectionObserverInit = {
      root: null,
      rootMargin: '-20% 0px -50% 0px',
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveDeck(entry.target.id);
        }
      });
    }, observerOptions);

    sectionElements.forEach((sec) => observer.observe(sec));
  }

  // Smooth scroll handler with header offset
  deckCards.forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const targetId = anchor.getAttribute('href')?.substring(1);
      if (!targetId) return;
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        e.preventDefault();
        const headerOffset = 70;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth',
        });

        updateActiveDeck(targetId);
      }
    });
  });
</script>
