---
interface SectionPreview {
  id: string;
  num: string;
  label: string;
  tag: string;
  description: string;
  stack: string;
  previewType: 'hero' | 'infra' | 'net' | 'portview' | 'projects' | 'timeline' | 'contact';
}

const sections: SectionPreview[] = [
  {
    id: 'hero',
    num: '01',
    label: 'Overview',
    tag: '// PROFILE & IDENTITY',
    description: 'C++ Developer & Server Administrator profile',
    stack: 'C++ · Linux · Server Admin',
    previewType: 'hero',
  },
  {
    id: 'infrastructure',
    num: '02',
    label: 'Infrastructure',
    tag: '// SYSTEMS & VIRTUALIZATION',
    description: 'Hypervisors, Linux servers, RAID & VMs',
    stack: 'Proxmox VE · VMware · Ubuntu',
    previewType: 'infra',
  },
  {
    id: 'networking',
    num: '03',
    label: 'Networking',
    tag: '// NETWORK & SECURITY',
    description: 'Mikrotik & Cisco routing, firewall policies',
    stack: 'Mikrotik · Cisco · Firewall',
    previewType: 'net',
  },
  {
    id: 'portview',
    num: '04',
    label: 'portview (C++)',
    tag: '// FLAGSHIP C++ SYSTEM TOOL',
    description: 'Win32 socket monitor & PID process mapper',
    stack: 'Win32 API · C++ · IPHLPAPI',
    previewType: 'portview',
  },
  {
    id: 'projects',
    num: '05',
    label: 'Projects',
    tag: '// GITHUB REPOSITORIES',
    description: 'Pinned open-source software and tools',
    stack: 'Open Source · GitHub',
    previewType: 'projects',
  },
  {
    id: 'experience',
    num: '06',
    label: 'Experience',
    tag: '// CAREER & EDUCATION',
    description: 'Work history at BFIN IT, Joy Cinemas & ALO',
    stack: '3+ Years · BSc CSE',
    previewType: 'timeline',
  },
  {
    id: 'contact',
    num: '07',
    label: 'Contact',
    tag: '// DIRECT CHANNELS',
    description: 'Direct message form & email contact',
    stack: 'Available for Roles',
    previewType: 'contact',
  },
];
---

<!-- Individual Floating Section Cards Stack (Desktop xl+) -->
<aside
  id="section-nav-deck"
  aria-label="Section Quick Navigator"
  class="fixed right-0 top-1/2 -translate-y-1/2 z-40 hidden xl:flex flex-col items-end space-y-2 select-none font-mono pointer-events-none pr-0"
>
  {sections.map((sec) => (
    <div class="relative group/card flex items-center justify-end pointer-events-auto">
      
      <!-- Hover Popout Preview Card (Left Floating Snapshot) -->
      <div
        class="stack-popout-preview absolute right-full mr-4 top-1/2 -translate-y-1/2 w-80 p-4 rounded-2xl bg-white dark:bg-zinc-950 border-2 border-zinc-300 dark:border-zinc-700 shadow-2xl opacity-0 pointer-events-none group-hover/card:opacity-100 group-hover/card:pointer-events-auto transition-all duration-200 transform translate-x-2 group-hover/card:translate-x-0 z-50 text-left"
      >
        <!-- Header -->
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
            {sec.tag}
          </span>
          <span class="text-xs px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 font-bold">
            {sec.num}
          </span>
        </div>

        <h4 class="text-sm font-extrabold text-zinc-900 dark:text-zinc-50 mb-1">
          {sec.label}
        </h4>

        <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
          {sec.description}
        </p>

        <!-- High-Contrast Live Snapshot Mockup -->
        <div class="relative w-full h-20 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950 p-2.5 text-xs text-zinc-200 font-mono shadow-inner mb-3">
          {sec.previewType === 'hero' && (
            <div class="h-full flex items-center justify-between">
              <div class="space-y-1">
                <div class="text-emerald-400 font-bold text-xs">Robin Mia (@mrun1corn)</div>
                <div class="text-zinc-300 text-[11px]">C++ Dev & Server Admin</div>
                <div class="text-zinc-500 text-[10px]">BFIN IT · Dhaka</div>
              </div>
              <div class="w-24 h-full bg-zinc-900 rounded-lg border border-zinc-800 p-1.5 text-[10px] flex flex-col justify-center">
                <div class="text-emerald-400 font-bold">$ whoami</div>
                <div class="text-cyan-300 font-semibold truncate">mrun1corn</div>
              </div>
            </div>
          )}

          {sec.previewType === 'infra' && (
            <div class="h-full flex items-center gap-1.5">
              <div class="flex-1 bg-zinc-900 rounded-lg border border-zinc-800 p-1.5 text-center">
                <div class="text-emerald-400 font-bold text-[11px]">Proxmox</div>
                <div class="text-[9px] text-zinc-300">Hypervisor</div>
              </div>
              <div class="flex-1 bg-zinc-900 rounded-lg border border-zinc-800 p-1.5 text-center">
                <div class="text-emerald-400 font-bold text-[11px]">Ubuntu</div>
                <div class="text-[9px] text-zinc-300">Server OS</div>
              </div>
              <div class="flex-1 bg-zinc-900 rounded-lg border border-zinc-800 p-1.5 text-center">
                <div class="text-emerald-400 font-bold text-[11px]">RAID/VM</div>
                <div class="text-[9px] text-zinc-300">Storage</div>
              </div>
            </div>
          )}

          {sec.previewType === 'net' && (
            <div class="h-full flex items-center justify-between px-1">
              <div class="space-y-1">
                <div class="text-cyan-400 font-bold text-xs">Mikrotik & Cisco</div>
                <div class="text-[10px] text-zinc-300">Routing, VLAN & Firewall</div>
              </div>
              <div class="px-2 py-1 rounded-md bg-cyan-950 border border-cyan-800 text-cyan-300 font-bold text-[10px]">
                🔒 Shield
              </div>
            </div>
          )}

          {sec.previewType === 'portview' && (
            <div class="h-full flex items-center justify-between">
              <div class="space-y-1">
                <div class="text-emerald-400 font-bold text-xs">portview.exe (C++)</div>
                <div class="text-[10px] text-cyan-300">IPHLPAPI Socket Enum</div>
              </div>
              <div class="w-28 h-full bg-zinc-900 rounded-lg border border-emerald-500/30 p-1.5 text-[9px] leading-tight text-zinc-300 flex flex-col justify-center">
                <div class="text-emerald-300 font-bold">127.0.0.1:8080</div>
                <div class="text-zinc-400 truncate">nginx.exe [4212]</div>
              </div>
            </div>
          )}

          {sec.previewType === 'projects' && (
            <div class="h-full flex items-center gap-1.5">
              <div class="flex-1 bg-zinc-900 rounded-lg border border-purple-800/50 p-1.5 text-[10px]">
                <div class="text-purple-400 font-bold">portview</div>
                <div class="text-zinc-400 text-[9px]">C++ Tool</div>
              </div>
              <div class="flex-1 bg-zinc-900 rounded-lg border border-purple-800/50 p-1.5 text-[10px]">
                <div class="text-purple-400 font-bold">Anyn0te</div>
                <div class="text-zinc-400 text-[9px]">Fullstack</div>
              </div>
            </div>
          )}

          {sec.previewType === 'timeline' && (
            <div class="h-full flex items-center justify-between px-1">
              <div class="border-l-2 border-emerald-500 pl-2 space-y-1">
                <div class="text-emerald-400 font-bold text-[11px]">BFIN IT (C++ Developer)</div>
                <div class="text-zinc-300 text-[10px]">Joy Cinemas · ALO Comm</div>
              </div>
              <div class="text-[10px] text-zinc-400 font-mono">2022–2026</div>
            </div>
          )}

          {sec.previewType === 'contact' && (
            <div class="h-full flex items-center justify-between px-1">
              <div class="space-y-1">
                <div class="text-emerald-400 font-bold text-xs">Direct Message</div>
                <div class="text-[10px] text-zinc-300">Available for Opportunities</div>
              </div>
              <div class="px-2.5 py-1 rounded-md bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-[10px] font-bold">
                ✉ Send
              </div>
            </div>
          )}
        </div>

        <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs">
          <span class="text-zinc-500 dark:text-zinc-400 font-medium truncate max-w-[160px]">{sec.stack}</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-bold flex items-center space-x-1">
            <span>Navigate</span>
            <span>↵</span>
          </span>
        </div>
      </div>

      <!-- Individual Floating Card Bar (60% tucked to the right, glides out on hover) -->
      <a
        href={`#${sec.id}`}
        data-stack-target={sec.id}
        aria-label={`Jump to ${sec.label}`}
        class="stack-card translate-x-[58%] group-hover/card:translate-x-0 w-60 py-2.5 px-3.5 rounded-l-2xl bg-white dark:bg-zinc-900 border-2 border-r-0 border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 dark:hover:border-emerald-400 shadow-xl transition-all duration-300 ease-out flex items-center justify-between cursor-pointer"
      >
        <div class="flex items-center space-x-3 whitespace-nowrap overflow-visible">
          <!-- Number Badge (Stays visible while tucked) -->
          <span class="stack-num text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 group-hover/card:text-emerald-600 dark:group-hover/card:text-emerald-400 transition-colors shadow-sm">
            {sec.num}
          </span>
          <!-- Unclipped Full Label -->
          <span class="stack-label text-xs sm:text-sm font-bold text-zinc-800 dark:text-zinc-100 group-hover/card:text-emerald-600 dark:group-hover/card:text-emerald-400 transition-colors whitespace-nowrap">
            {sec.label}
          </span>
        </div>

        <!-- Live Active Dot Indicator -->
        <span class="stack-indicator w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700 ml-3 transition-all shrink-0"></span>
      </a>

    </div>
  ))}

  <!-- Floating Minimal Status Badge Below Stack -->
  <div class="pointer-events-auto pr-3 pt-2">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/90 dark:bg-zinc-900/90 border border-zinc-200 dark:border-zinc-800 shadow-lg text-[11px] font-bold text-zinc-600 dark:text-zinc-300">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-emerald-600 dark:text-emerald-400">// STACK</span>
      <span id="stack-counter" class="font-mono text-zinc-800 dark:text-zinc-200">01/07</span>
    </div>
  </div>
</aside>

<script>
  const stackCards = document.querySelectorAll<HTMLAnchorElement>('.stack-card');
  const stackCounter = document.getElementById('stack-counter');

  const sectionMeta: Record<string, { num: string; label: string; index: number }> = {
    hero: { num: '01', label: 'Overview', index: 1 },
    infrastructure: { num: '02', label: 'Infrastructure', index: 2 },
    networking: { num: '03', label: 'Networking', index: 3 },
    portview: { num: '04', label: 'portview (C++)', index: 4 },
    projects: { num: '05', label: 'Projects', index: 5 },
    experience: { num: '06', label: 'Experience', index: 6 },
    contact: { num: '07', label: 'Contact', index: 7 },
  };

  const sectionElements: HTMLElement[] = [];
  Object.keys(sectionMeta).forEach((id) => {
    const el = document.getElementById(id);
    if (el) sectionElements.push(el);
  });

  function updateActiveStack(currentId: string) {
    const meta = sectionMeta[currentId];
    if (meta && stackCounter) {
      stackCounter.textContent = `${meta.num}/07`;
    }

    stackCards.forEach((card) => {
      const target = card.getAttribute('data-stack-target');
      const indicator = card.querySelector('.stack-indicator');
      const numBadge = card.querySelector('.stack-num');
      const label = card.querySelector('.stack-label');

      if (target === currentId) {
        card.classList.add(
          'border-emerald-500',
          'dark:border-emerald-400',
          'bg-emerald-50',
          'dark:bg-emerald-950/60',
          'shadow-emerald-500/20'
        );
        card.classList.remove('border-zinc-200', 'dark:border-zinc-800', 'bg-white', 'dark:bg-zinc-900');
        
        indicator?.classList.add('bg-emerald-500', 'animate-pulse', 'scale-125');
        indicator?.classList.remove('bg-zinc-300', 'dark:bg-zinc-700');
        
        numBadge?.classList.add('bg-emerald-500', 'text-zinc-950', 'border-emerald-400');
        numBadge?.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-700', 'dark:text-zinc-300');
        
        label?.classList.add('text-emerald-700', 'dark:text-emerald-300', 'font-extrabold');
        label?.classList.remove('text-zinc-800', 'dark:text-zinc-100');
      } else {
        card.classList.remove(
          'border-emerald-500',
          'dark:border-emerald-400',
          'bg-emerald-50',
          'dark:bg-emerald-950/60',
          'shadow-emerald-500/20'
        );
        card.classList.add('border-zinc-200', 'dark:border-zinc-800', 'bg-white', 'dark:bg-zinc-900');
        
        indicator?.classList.remove('bg-emerald-500', 'animate-pulse', 'scale-125');
        indicator?.classList.add('bg-zinc-300', 'dark:bg-zinc-700');
        
        numBadge?.classList.remove('bg-emerald-500', 'text-zinc-950', 'border-emerald-400');
        numBadge?.classList.add('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-700', 'dark:text-zinc-300');
        
        label?.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'font-extrabold');
        label?.classList.add('text-zinc-800', 'dark:text-zinc-100');
      }
    });
  }

  // Active Section Observer
  if (sectionElements.length > 0) {
    const observerOptions: IntersectionObserverInit = {
      root: null,
      rootMargin: '-20% 0px -50% 0px',
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveStack(entry.target.id);
        }
      });
    }, observerOptions);

    sectionElements.forEach((sec) => observer.observe(sec));
  }

  // Smooth scroll handler with header offset
  stackCards.forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const targetId = anchor.getAttribute('href')?.substring(1);
      if (!targetId) return;
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        e.preventDefault();
        const headerOffset = 70;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth',
        });

        updateActiveStack(targetId);
      }
    });
  });
</script>
