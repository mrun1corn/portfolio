---

<!-- Floating Interactive Section Minimap Deck (Desktop xl+) -->
<aside
  id="section-nav-deck"
  aria-label="Section Quick Navigator"
  class="hidden xl:flex fixed right-6 top-1/2 -translate-y-1/2 z-40 flex-col items-center select-none animate-fade-in-up"
>
  <!-- Background Rail Container -->
  <div class="relative flex flex-col items-center py-3 px-2 rounded-2xl bg-[var(--color-bg-base)]/80 backdrop-blur-xl border border-[var(--color-border)] shadow-xl">
    
    <!-- Vertical Connecting Line -->
    <div class="absolute top-6 bottom-6 w-[2px] bg-[var(--color-border)]/70 -z-0"></div>

    <!-- Section Stack Nodes -->
    <nav class="flex flex-col space-y-4 relative z-10">
      {sections.map((sec) => (
        <div class="relative group flex items-center justify-center">
          
          <!-- Node Button -->
          <a
            href={`#${sec.id}`}
            data-section-target={sec.id}
            aria-label={`Jump to ${sec.label} section`}
            class="deck-node w-9 h-9 rounded-xl flex items-center justify-center font-mono text-xs transition-all duration-300 bg-[var(--color-bg-surface)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-emerald-500/60 hover:text-emerald-500 hover:scale-110 shadow-sm cursor-pointer"
          >
            <span class="node-icon group-hover:scale-110 transition-transform" set:html={sec.iconSvg} />
          </a>

          <!-- Hover Preview Card (Sliding in from the left) -->
          <div
            class="deck-preview-card absolute right-12 top-1/2 -translate-y-1/2 w-64 p-4 rounded-2xl bg-[var(--color-bg-base)]/95 backdrop-blur-xl border border-[var(--color-border)] shadow-2xl opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 transform translate-x-2 group-hover:translate-x-0 z-50 text-left"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[10px] font-mono font-semibold text-emerald-600 dark:text-emerald-400">
                {sec.tag}
              </span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[var(--color-bg-surface-hover)] border border-[var(--color-border)] text-[var(--color-text-tertiary)]">
                {sec.num}
              </span>
            </div>

            <h4 class="text-sm font-bold text-[var(--color-text-primary)] font-mono mb-1">
              {sec.label}
            </h4>

            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed mb-2.5">
              {sec.description}
            </p>

            <div class="pt-2 border-t border-[var(--color-border)]/60 flex items-center justify-between text-[10px] font-mono text-[var(--color-text-tertiary)]">
              <span class="truncate max-w-[140px] text-zinc-400">{sec.stack}</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-semibold flex items-center space-x-0.5 group-hover:translate-x-0.5 transition-transform">
                <span>Jump</span>
                <span>↵</span>
              </span>
            </div>
          </div>

        </div>
      ))}
    </nav>
  </div>
</aside>

<script>
  // Active State Observer for the Deck
  const deckNodes = document.querySelectorAll<HTMLAnchorElement>('.deck-node');
  const sectionIds = ['hero', 'infrastructure', 'networking', 'portview', 'projects', 'experience', 'contact'];
  const sectionElements: HTMLElement[] = [];

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) sectionElements.push(el);
  });

  function setActiveDeckNode(currentId: string) {
    deckNodes.forEach((node) => {
      const target = node.getAttribute('data-section-target');
      if (target === currentId) {
        node.classList.add(
          'bg-emerald-500',
          'text-zinc-950',
          'border-emerald-400',
          'shadow-lg',
          'shadow-emerald-500/25',
          'scale-110'
        );
        node.classList.remove('bg-[var(--color-bg-surface)]', 'text-[var(--color-text-secondary)]');
      } else {
        node.classList.remove(
          'bg-emerald-500',
          'text-zinc-950',
          'border-emerald-400',
          'shadow-lg',
          'shadow-emerald-500/25',
          'scale-110'
        );
        node.classList.add('bg-[var(--color-bg-surface)]', 'text-[var(--color-text-secondary)]');
      }
    });
  }

  // Set up observer
  if (sectionElements.length > 0) {
    const observerOptions: IntersectionObserverInit = {
      root: null,
      rootMargin: '-20% 0px -50% 0px',
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActiveDeckNode(entry.target.id);
        }
      });
    }, observerOptions);

    sectionElements.forEach((sec) => observer.observe(sec));
  }

  // Smooth scroll handler with header offset
  deckNodes.forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const targetId = anchor.getAttribute('href')?.substring(1);
      if (!targetId) return;
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        e.preventDefault();
        const headerOffset = 70;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth',
        });

        setActiveDeckNode(targetId);
      }
    });
  });
</script>
