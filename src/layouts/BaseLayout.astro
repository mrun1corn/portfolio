---
import '../styles/global.css';
import SectionNavDeck from '../components/SectionNavDeck.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Robin Mia | C++ Developer & Server Administrator",
  description = "Portfolio of Robin Mia (mrun1corn) — C++ Developer, Server Administrator, and Infrastructure Engineer specializing in C++ software development, Linux server management, virtualization, and networking."
} = Astro.props;

const siteUrl = "https://mrun1corn.xyz";
const ogImageUrl = `${siteUrl}/og-image.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Robin Mia | C++ Developer & Server Administrator",
      "description": description,
      "inLanguage": "en-US",
      "publisher": {
        "@id": `${siteUrl}/#person`
      }
    },
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}/#profilepage`,
      "url": siteUrl,
      "name": title,
      "isPartOf": {
        "@id": `${siteUrl}/#website`
      },
      "mainEntity": {
        "@id": `${siteUrl}/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Robin Mia",
      "alternateName": ["mrun1corn", "robin mia"],
      "url": siteUrl,
      "image": ogImageUrl,
      "jobTitle": "C++ Developer & Server Administrator",
      "worksFor": {
        "@type": "Organization",
        "name": "BFIN IT",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Mohammadpur, Dhaka",
          "addressCountry": "BD"
        }
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "University of South Asia"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Uttara Engineering College"
        }
      ],
      "sameAs": [
        "https://github.com/mrun1corn",
        "https://x.com/Robin33090740",
        "https://t.me/mrun1corn"
      ],
      "knowsAbout": [
        "C++",
        "C++20",
        "Systems Programming",
        "Linux",
        "Ubuntu",
        "Server Administration",
        "Proxmox VE",
        "VMware",
        "Mikrotik RouterOS",
        "Cisco IOS",
        "Network Engineering",
        "Win32 API",
        "Astro",
        "Tailwind CSS"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Inline Theme Detection Script (Prevents FOUC & Default System Preference) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Robin Mia (mrun1corn)" />
    <meta name="keywords" content="Robin Mia, mrun1corn, C++ Developer, Server Administrator, Linux Administrator, Infrastructure Engineer, Systems Programming, Proxmox VE, VMware, Mikrotik, Cisco, Portview, BFIN IT, Dhaka Bangladesh" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="https://mrun1corn.xyz" />
    <link rel="alternate" hreflang="x-default" href="https://mrun1corn.xyz/" />
    <link rel="alternate" hreflang="en" href="https://mrun1corn.xyz/" />
    <meta name="theme-color" content="#0b0f19" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://mrun1corn.xyz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Robin Mia Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Robin Mia — C++ Developer & Server Administrator" />
    <meta property="profile:first_name" content="Robin" />
    <meta property="profile:last_name" content="Mia" />
    <meta property="profile:username" content="mrun1corn" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Robin33090740" />
    <meta name="twitter:creator" content="@Robin33090740" />
    <meta name="twitter:url" content="https://mrun1corn.xyz" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Robin Mia — C++ Developer & Server Administrator" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- JSON-LD Structured Data for Google Search Console -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[var(--color-bg-base)] text-[var(--color-text-primary)] font-sans min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-300 transition-colors duration-300">
    <slot />
    <SectionNavDeck />
  </body>
</html>
